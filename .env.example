# Redis (Docker Compose memory limit can be overridden with REDIS_MAXMEMORY=512mb)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=0.5

# Answer cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_PREFIX=rag:answer

# RAG
DOCS_DIR=./data/docs
CHUNK_MAX_CHARS=500
TOP_K=3
MIN_SCORE=0.05
# LLM provider: extractive (default, local) or openai_compatible (OpenAI, Ollama, vLLM, ...)
LLM_PROVIDER=extractive
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30

# Stampede protection
STAMPEDE_LOCK_TTL_SECONDS=30
STAMPEDE_WAIT_SECONDS=5

# Benchmark-only: artificial delay (ms) added to the generator to emulate a remote LLM. Keep 0 normally.
LLM_SIMULATED_LATENCY_MS=0

# HTTP
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
